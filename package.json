{
  "name": "@acedatacloud/n8n-nodes-ace-chat-model",
  "version": "0.1.0",
  "description": "Use Ace Data Cloud chat models in n8n AI Agents and chains through one chat API.",
  "license": "MIT",
  "homepage": "https://github.com/AceDataCloud/AceChatN8N",
  "keywords": ["n8n-community-node-package", "acedatacloud", "chat-model", "ai"],
  "author": { "name": "Ace Data Cloud", "email": "dev@acedata.cloud", "url": "https://platform.acedata.cloud" },
  "repository": { "type": "git", "url": "git+https://github.com/AceDataCloud/AceChatN8N.git" },
  "bugs": { "url": "https://github.com/AceDataCloud/AceChatN8N/issues" },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "test": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": ["dist/credentials", "dist/nodes", "examples"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "aiNodeSdkVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/AceDataChatApi.credentials.js"],
    "nodes": ["dist/nodes/LmChatAceDataCloud/LmChatAceDataCloud.node.js"]
  },
  "devDependencies": {
    "@n8n/ai-node-sdk": "0.32.2",
    "@n8n/node-cli": "0.51.2",
    "n8n-workflow": "2.42.2",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "eslint": "9.29.0"
  },
  "peerDependencies": { "@n8n/ai-node-sdk": "*", "n8n-workflow": "*" },
  "publishConfig": { "access": "public", "provenance": true }
}
